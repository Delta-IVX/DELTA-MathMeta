<%- include('partials/header') %>

<main class="container">

    <form action="/solve" method="post" class="card">
        <label>Escolha a Equação:</label>

        <select name="type" id="equation-select">
            <option value="primeiro-grau">Equação de Primeiro Grau</option>
            <option value="segundo-grau">Equação de Segundo Grau</option>
        </select>

        <div class="inputs">
            <input type="number" step="any" name="a" placeholder="Valor de A">
            <input type="number" step="any" name="b" placeholder="Valor de B">
            <input type="number" step="any" name="c" placeholder="Valor de C (2º Grau)">
            <input type="number" step="any" name="x" placeholder="Valor de X (Opcional)">
        </div>

        <button type="submit">Calcular</button>

    </form>
</main>